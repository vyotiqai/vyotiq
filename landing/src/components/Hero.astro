---
import { SITE_PRODUCT } from '../lib/site'
import ReleaseInstallers from './ReleaseInstallers.astro'
---

<section id="overview" class="home-hero wrap" aria-labelledby="home-title">
  <div class="home-hero-copy">
    <p class="home-eyebrow">{SITE_PRODUCT}</p>
    <h1 id="home-title">Understand, change, and review real repositories.</h1>
    <p>
      Open a local repository, pick a configured model, and keep the current run in one window.
    </p>
    <ReleaseInstallers />
  </div>
</section>

<style>
  .home-hero-copy > .home-eyebrow {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }
</style>
