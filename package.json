{
  "name": "vyotiq",
  "version": "1.0.0",
  "description": "Vyotiq Agent V — lean NL harness desktop coding agent",
  "packageManager": "pnpm@11.20.0",
  "main": "./out/main/index.js",
  "author": "Vyotiq",
  "homepage": "https://vyotiq.com",
  "scripts": {
    "dev": "pnpm sync:file-icons && electron-vite dev",
    "build": "pnpm sync:file-icons && pnpm typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/main/e2e",
    "test:gui-e2e": "playwright test -c tests/gui-e2e/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "start": "electron-vite preview",
    "pack": "pnpm build && electron-builder --win --mac --linux",
    "pack:win": "pnpm build && electron-builder --win",
    "pack:mac": "pnpm build && electron-builder --mac",
    "pack:linux": "pnpm build && electron-builder --linux",
    "sync:provider-icons": "node scripts/sync-provider-brand-paths.mjs",
    "sync:file-icons": "node scripts/sync-file-icons.mjs",
    "postinstall": "node node_modules/electron/install.js && (electron-builder install-app-deps || node -e \"console.warn('[vyotiq] native module rebuild failed — node-pty will use pipe fallback if unavailable')\") && node scripts/sync-file-icons.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lobehub/icons": "^5.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/electron": "^7.15.0",
    "@sentry/react": "10.67.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "electron-log": "^5.4.4",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^1.27.0",
    "material-icon-theme": "^5.37.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "tree-kill": "^1.2.2",
    "unpdf": "^1.6.2",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  }
}
