---
import { SITE_PRODUCT } from '../lib/site'
import LandingIcon from './LandingIcon.astro'
---

<section id="overview" class="home-hero wrap" aria-labelledby="home-title">
  <div class="home-hero-copy">
    <p class="home-eyebrow">{SITE_PRODUCT}</p>
    <h1 id="home-title">Understand, change, and review real repositories.</h1>
    <p>
      Work with repository context, editing, terminal, browser, and Git tools in one coding
      workspace.
    </p>
    <a class="home-text-link" href="https://github.com/vyotiqai/vyotiq/releases/latest">
      GitHub Releases
      <LandingIcon name="arrow-up-right" />
    </a>
    <a class="home-text-link" href="/docs">
      Read the documentation
      <LandingIcon name="arrow-up-right" />
    </a>
  </div>
</section>

<style>
  .home-hero-copy > .home-eyebrow {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }
</style>
