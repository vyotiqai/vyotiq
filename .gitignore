# Secrets and local env (keep committed examples)
.env
.env.*
!.env.example
!.env.*.example

# Generated synced assets (scripts/sync-*.mjs on postinstall/dev/build)
src/renderer/public/file-icons/
resources/codeindex/wasm/

# Markdown siblings generated from .md.docx (scripts/sync-docx-md.mjs)
