---
import ProviderMarks from './ProviderMarks.astro'
import LandingIcon from './LandingIcon.astro'

const workspaceSurfaces = [
  {
    name: 'Files',
    detail: 'Navigate the repository tree and edit workspace files.'
  },
  {
    name: 'Browser',
    detail: 'Inspect and act on websites in the embedded browser.'
  },
  {
    name: 'Terminal',
    detail: 'Run project commands and inspect their captured output.'
  },
  {
    name: 'Changes',
    detail: 'Review working-tree status, diffs, and checkpoint actions.'
  },
  {
    name: 'Pull Request',
    detail: 'Work with GitHub pull requests through the GitHub CLI boundary.'
  },
  {
    name: 'Plan',
    detail: 'Keep the run contract, plan, and todos visible as work progresses.'
  }
]

const modes = [
  {
    name: 'Ask',
    detail: 'Investigate with read-only built-ins and browse-only browser actions.'
  },
  {
    name: 'Plan',
    detail: 'Use read tools, todos, diagnostics, and edits limited to run plan and contract files.'
  },
  {
    name: 'Agent',
    detail: 'Edit product files and use the full built-in tool catalog, subject to approvals.'
  }
]

const continuityItems = [
  'Workspace sessions keep chats and run state connected to the repository.',
  'Background runs can surface completion, failure, or a request for attention through notifications.',
  'Context estimates help plan the next turn; compaction summarizes older history when needed.',
  'Contracts, plans, todos, and receipts preserve intent and structured run evidence.'
]

const extensionItems = [
  {
    name: 'MCPs',
    detail: 'Connect tools and resources from configured Model Context Protocol servers.'
  },
  {
    name: 'Skills',
    detail: 'Add task-specific instructions and workflows.'
  },
  {
    name: 'Rules',
    detail: 'Apply persistent user or workspace guidance.'
  },
  {
    name: 'Packages',
    detail: 'Install and scope Marketplace bundles through explicit lifecycle controls.'
  }
]

const docsLinks = [
  {
    label: 'Workflow',
    detail: 'Start with a workspace, provider, and first reviewed run.',
    href: '/docs/start/quickstart'
  },
  {
    label: 'Tools',
    detail: 'See the built-in tool catalog and mode availability.',
    href: '/docs/reference/tools'
  },
  {
    label: 'Providers',
    detail: 'Configure provider hosts, credentials, and models.',
    href: '/docs/customize/providers'
  },
  {
    label: 'Privacy and security',
    detail: 'Understand stored data, external requests, approvals, and recovery limits.',
    href: '/docs/concepts/privacy-data'
  }
]
---

<div class="home-sections">
  <section id="capabilities" class="home-section wrap" aria-labelledby="workspace-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">01 / Integrated workspace</p>
      <h2 id="workspace-title">One place to understand, change, and review a repository.</h2>
      <p>
        Search the codebase, edit files, run commands, use the web, and review Git state without
        breaking the task into disconnected surfaces.
      </p>
    </header>
    <ul class="home-surface-grid">
      {
        workspaceSurfaces.map((surface) => (
          <li>
            <h3>{surface.name}</h3>
            <p>{surface.detail}</p>
          </li>
        ))
      }
    </ul>
    <a class="home-text-link" href="/docs/reference/layout">
      Tour the workspace
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="modes-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">02 / Controlled modes</p>
      <h2 id="modes-title">Choose how the agent works.</h2>
      <p>
        The mode changes which actions are available. Start with investigation, make decisions
        explicit, then move into implementation when the task is ready.
      </p>
    </header>
    <ol class="home-mode-list">
      {
        modes.map((mode, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{mode.name}</h3>
              <p>{mode.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <a class="home-text-link" href="/docs/agent/modes">
      Compare modes
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="continuity-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">03 / Long-running work</p>
      <h2 id="continuity-title">Stay oriented as the task grows.</h2>
      <p>
        Runs carry more than a transcript. Agent V keeps the state and artifacts needed to return
        to work, understand what happened, and decide what comes next.
      </p>
    </header>
    <div class="home-split">
      <ul class="home-plain-list">
        {continuityItems.map((item) => <li>{item}</li>)}
      </ul>
      <aside class="home-note" aria-labelledby="checkpoint-title">
        <h3 id="checkpoint-title">Checkpoint boundary</h3>
        <p>
          Checkpoints cover guarded agent writes. They are not Git commits and cannot reverse
          terminal commands, browser actions, MCP calls, GitHub operations, or other remote side
          effects.
        </p>
        <a class="home-text-link" href="/docs/agent/checkpoints">
          Understand checkpoints
          <LandingIcon name="arrow-up-right" />
        </a>
      </aside>
    </div>
  </section>

  <section class="home-section wrap" aria-labelledby="providers-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">04 / Provider choice</p>
      <h2 id="providers-title">Use the models you configure.</h2>
      <p>
        Configure Ollama, eight named cloud providers, or a custom OpenAI-compatible host, then
        choose among the models exposed by that configuration.
      </p>
    </header>
    <div class="home-provider-layout">
      <ProviderMarks />
      <div class="home-note">
        <h3>Initial selection</h3>
        <p>
          New settings initially select Ollama with <code>qwen2.5</code>. That selection does not
          install or start Ollama, and the endpoint may not be reachable.
        </p>
        <a class="home-text-link" href="/docs/customize/providers">
          Configure providers
          <LandingIcon name="arrow-up-right" />
        </a>
      </div>
    </div>
  </section>

  <section class="home-section wrap" aria-labelledby="extensions-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">05 / Deliberate extension</p>
      <h2 id="extensions-title">Add context and capability on purpose.</h2>
      <p>
        Extend the repository workflow when the task calls for it, without making extensions the
        center of the day-to-day workspace.
      </p>
    </header>
    <ul class="home-extension-grid">
      {
        extensionItems.map((item) => (
          <li>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
          </li>
        ))
      }
    </ul>
    <p class="home-supporting-copy">
      Explicit Markdown memory lives under <code>.vyotiq/memory/</code>. Optional code indexing
      keeps derived indexes locally; it is separate from memory.
    </p>
    <a class="home-text-link" href="/docs/customize/marketplace">
      Explore customization
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section wrap" aria-labelledby="boundaries-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">06 / Data boundaries</p>
      <h2 id="boundaries-title">Local state, explicit network boundaries.</h2>
      <p>
        Workspace files, run records, settings, indexes, and rotating logs are stored on the
        machine. Requests cross that boundary when the work requires an external service.
      </p>
    </header>
    <div class="home-boundary-grid">
      <article>
        <h3>Stored credentials</h3>
        <p>
          Provider keys, MCP bearer tokens, and GitHub tokens use operating-system secure storage
          where available.
        </p>
      </article>
      <article>
        <h3>Approval controls</h3>
        <p>
          Tool approval can gate mutating tools or every tool, while named tools can be
          allowlisted. Browser navigation can also use an optional domain allowlist.
        </p>
      </article>
      <article>
        <h3>External requests</h3>
        <p>
          Configured providers, visited websites, GitHub, OpenAI or OpenRouter dictation, and remote
          MCP servers receive the content required for the request made to them.
        </p>
      </article>
      <article>
        <h3>Crash reporting</h3>
        <p>
          Crash and error sharing is opt-in and only available in builds configured for that
          reporting path.
        </p>
      </article>
    </div>
    <a class="home-text-link" href="/docs/concepts/security">
      Review security boundaries
      <LandingIcon name="arrow-up-right" />
    </a>
  </section>

  <section class="home-section home-docs-section wrap" aria-labelledby="docs-title">
    <header class="home-section-heading">
      <p class="home-eyebrow">07 / Documentation</p>
      <h2 id="docs-title">Explore the product in detail.</h2>
      <p>Follow the path that matches the decision or task in front of you.</p>
    </header>
    <nav aria-label="Product documentation">
      <ul class="home-docs-grid">
        {
          docsLinks.map((link) => (
            <li>
              <a href={link.href}>
                <span>{link.label}</span>
                <small>{link.detail}</small>
                <LandingIcon name="arrow-up-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</div>
