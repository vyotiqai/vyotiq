---
import DocsLayout from '../../layouts/DocsLayout.astro'
import { docsHref, docsSectionHref, groupedDocs } from '../../lib/docs'

const groups = await groupedDocs()
---

<DocsLayout
  title="Docs"
  description="Install Agent V, complete a first useful run, learn each work surface, and recover when something fails."
>
  {
    groups.map((group) => (
      <section>
        <h2>
          <a href={docsSectionHref(group.section)}>{group.label}</a>
        </h2>
        <ul class="docs-index-list">
          {group.entries.map((entry) => (
            <li>
              <a href={docsHref(entry.id)}>{entry.data.title}</a>
              <span>{entry.data.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</DocsLayout>
