{
  "name": "vyotiq",
  "version": "1.0.0",
  "description": "Agent V — coding workspace for real repositories",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./out/main/index.js",
  "author": "Vyotiq",
  "homepage": "https://vyotiq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vyotiqai/vyotiq-agent-v.git"
  },
  "scripts": {
    "dev": "pnpm sync:harness && pnpm sync:file-icons && pnpm sync:codeindex-wasm && electron-vite dev",
    "build": "pnpm typecheck && pnpm build:vite",
    "build:vite": "pnpm sync:harness && pnpm sync:docx-md && pnpm sync:app-icon && pnpm sync:file-icons && pnpm sync:codeindex-wasm && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "pnpm sync:harness && pnpm sync:docx-md && vitest run",
    "test:coverage": "pnpm sync:harness && pnpm sync:docx-md && vitest run --coverage",
    "test:reliability": "vitest run tests/main/unit/runsState.test.ts tests/main/unit/agentLoopResume.test.ts tests/main/unit/followUpStore.test.ts tests/main/unit/loopCheckpoint.test.ts tests/main/unit/runRegistry.test.ts tests/main/unit/eventAppendQueue.test.ts tests/main/unit/networkMonitor.test.ts tests/main/unit/sparsegrepSyncPaginated.test.ts tests/main/unit/globIndex.test.ts tests/main/audit/enduranceRun.audit.test.ts tests/main/audit/largeRepoScanCap.audit.test.ts tests/renderer/chat/autoResume.test.tsx tests/renderer/chat/chatStreamController.test.ts",
    "test:e2e": "vitest run tests/main/e2e",
    "test:gui-e2e": "playwright test -c tests/gui-e2e/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "start": "electron-vite preview",
    "pack": "pnpm build && electron-builder --win --mac --linux --publish never",
    "pack:win": "pnpm build && electron-builder --win nsis --publish never",
    "pack:win:alt": "pnpm build && electron-builder --win nsis --publish never --config.directories.output=dist-package-alt",
    "pack:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "pack:linux": "pnpm build && electron-builder --linux AppImage --publish never",
    "pack:dir:win": "pnpm build && electron-builder --win dir --publish never",
    "pack:dir:win:alt": "pnpm build && electron-builder --win dir --publish never --config.directories.output=dist-package-alt",
    "sync:provider-icons": "node scripts/sync-provider-brand-paths.mjs",
    "sync:harness": "node scripts/sync-harness.mjs",
    "sync:docx-md": "node scripts/sync-docx-md.mjs",
    "sync:brand": "node scripts/generate-precision-mono-brand.mjs",
    "sync:app-icon": "node scripts/sync-app-icon.mjs",
    "sync:file-icons": "node scripts/sync-file-icons.mjs",
    "sync:codeindex-wasm": "node scripts/sync-codeindex-wasm.mjs",
    "sync:landing-brand": "node scripts/sync-landing-brand.mjs",
    "landing:dev": "pnpm sync:brand && pnpm sync:landing-brand && pnpm --filter @vyotiq/landing dev",
    "landing:build": "pnpm sync:brand && pnpm sync:landing-brand && pnpm --filter @vyotiq/landing build",
    "postinstall": "node node_modules/electron/install.js && (electron-builder install-app-deps || node -e \"console.warn('[vyotiq] native module rebuild failed — node-pty will use pipe fallback if unavailable')\") && node scripts/sync-file-icons.mjs && node scripts/sync-codeindex-wasm.mjs && node scripts/sync-harness.mjs && node scripts/sync-docx-md.mjs && node scripts/generate-precision-mono-brand.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@lobehub/icons": "^5.16.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/electron": "^7.17.0",
    "@sentry/react": "10.70.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cross-spawn": "^7.0.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gpt-tokenizer": "^4.0.0",
    "lucide-react": "^1.33.0",
    "material-icon-theme": "^5.37.0",
    "onnxruntime-node": "^1.27.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tree-kill": "^1.2.2",
    "tree-sitter-wasms": "^0.1.13",
    "unpdf": "^1.8.1",
    "web-tree-sitter": "^0.26.12",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "node-llama-cpp": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  }
}
