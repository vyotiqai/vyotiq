.commandcode/

# Python helpers
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.idea/
.vs/
*.iml

# Docs are stored as Word binaries in these trees. Catch-all ignores
# other .docx (including Windows "Copy (1)" collisions after the
# un-ignores below).
*.docx
!docs/**/*.docx
!resources/**/*.docx
!.cursor/**/*.docx
!.vyotiq/rules/**/*.docx
!landing/**/*.docx
!tests/**/*.docx

# Windows Explorer duplicate copies — after docx un-ignores so they win
* (1).*
*(1).*

# Not published with the product (must stay after docx un-ignores)
.cursor/
.devin/
.vyotiq/rules/
docs/
landing/
scripts/
.cursorrules
AGENTS.md
